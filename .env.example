# FinTech Market MCP Server Configuration
MCP_SERVER_NAME=fintech-market-telemetry
MCP_SERVER_VERSION=0.1.0
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_LOG_LEVEL=INFO
MARKET_DATA_RATE_HZ=100
DEFAULT_TICKERS=AAPL,MSFT,GOOGL,NVDA,TSLA
BUFFER_CAPACITY=100000

# Quantitative Risk & Monte Carlo Stress Testing Configuration
RISK_MONTE_CARLO_SIMULATIONS=10000
RISK_CONFIDENCE_LEVEL=0.95
RISK_FREE_RATE=0.045
RISK_STRESS_HORIZON_DAYS=30

